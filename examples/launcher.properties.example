# launcher.properties: lives on the TV at
#   /sdcard/Android/data/io.github.tvhomemodules.launcher/files/launcher.properties
# Read on every return to Home. Anything left out uses the built-in default
# (launcher/app/src/main/res/values/config.xml). The launcher also writes this
# template next to it on the TV as launcher.properties.example.
#
# Don't keep a filled-in copy in the repo: it holds your doorbell login and HA token
# (.gitignore excludes launcher.properties).

# ---- Module 00: Home ----------------------------------------------------
# Dock row 1 = red, green, yellow, blue buttons (package names: adb shell pm list packages)
dock=org.smarttube.stable,org.videolan.vlc,org.jellyfin.androidtv,com.android.vending
# Dock row 2 (up to 8); empty slots show "+". Dock edits made on the TV override both lines.
dock2=
# Image in the launcher's files folder (jpg/png), or an absolute path; empty = black
wallpaper=
# Packages to leave out of the grid
hidden=

# ---- Module 10: art screen saver -----------------------------------------
art_change_min=5
art_change_max=15
# Standby after this many minutes of screen saver (0 = never)
art_standby_min=60
# Paintings up to this year (1910 = old masters to Post-Impressionism)
art_until_year=1910
# Hold this key to start the screen saver now (185 = yellow, 0 = off)
screensaver_hold_key=185

# ---- Module 20: doorbell -------------------------------------------------
# Set by tools/set_doorbell.py; empty = no tile
#doorbell_url=rtsp://USER:PASSWORD@DOORBELL_IP:554/h264Preview_01_sub
#doorbell_fullscreen_url=rtsp://USER:PASSWORD@DOORBELL_IP:554/h264Preview_01_main
# Hold to open/close full screen from any app (186 = blue, 0 = off)
doorbell_hold_key=186
# Action per event: doorbell (full screen), pip (small picture over any app) or none
on_ring=doorbell
on_person=pip
on_motion=none
on_pet=none
on_vehicle=none
# Close full screen after this many seconds without activity (0 = never)
doorbell_auto_close_s=60
pip_auto_close_s=10
# Event source 1: ONVIF subscription to the doorbell (login from doorbell_url)
onvif=true
onvif_port=8000
# Event source 2: Home Assistant backup, POST http://<tv>:8765/event (token: tools/setup_events.py)
event_port=8765
#event_token=...

# ---- Module 30: Home Assistant lights panel -------------------------------
#ha_url=http://HA_IP:8123
#ha_token=...            (set by tools/set_ha.py)
# Lights with this label (all lights if none has it)
ha_label=TV
# The TV's room (HA area name), then the other rooms in this order
ha_tv_area=Living Room
ha_rooms=Living Room,Kitchen,Dining Room,Hall,Bathroom,Garden
# Motion-controlled lights: smaller, last in their room
ha_motion_label=Motion
# Hold this key to open the panel (183 = red, 0 = off)
ha_hold_key=183
