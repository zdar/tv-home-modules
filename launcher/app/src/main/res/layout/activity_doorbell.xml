<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen doorbell. A SurfaceView, so the TV puts the video on its own 4K
     video plane instead of the 1920x1080 UI layer. (Screenshots show it black.) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/doorbell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <SurfaceView
        android:id="@+id/doorbell_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/doorbell_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="36dp"
        android:background="@drawable/video_pill_bg"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="@string/doorbell"
        android:textColor="#F2FFFFFF"
        android:textSize="18sp" />
</FrameLayout>
