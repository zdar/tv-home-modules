<?xml version="1.0" encoding="utf-8"?>
<!-- Art screen saver: the painting as large as the screen allows, a faint one-line
     caption that fades away, and a small, dim clock -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Two image views crossfade into each other -->
    <ImageView
        android:id="@+id/art_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/art_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="fitCenter" />

    <!-- Placed in code: stacked in the black side band next to the painting's bottom
         edge, or one line along the painting's bottom when the band is too narrow.
         Fainter than the clock, shown for as long as the painting is -->
    <TextView
        android:id="@+id/art_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:alpha="0"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.15"
        android:shadowColor="#FF000000"
        android:shadowRadius="4"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/dream_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:alpha="0.3"
        android:includeFontPadding="false"
        android:shadowColor="#FF000000"
        android:shadowRadius="4"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />
</FrameLayout>
